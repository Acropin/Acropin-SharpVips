{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/food-images"
  ],
  "scripts": {
    "build:food-images": "node --import tsx scripts/build-food-images.ts",
    "predev": "npm run build:food-images",
    "dev": "tsx server.ts",
    "prestart": "npm run build:food-images",
    "start": "tsx server.ts",
    "prebuild": "npm run build:food-images",
    "build": "vite build",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:lint": "tsc --noEmit -p cloudflare/tsconfig.json",
    "cloudflare:deploy": "npm run build && wrangler deploy",
    "cloudflare:migrate": "wrangler d1 migrations apply acropin-food-catalog --remote",
    "cloudflare:sync": "node --import tsx scripts/sync-cloudflare-catalog.ts",
    "test": "npx --yes tsx --test src/**/*.test.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "prelint": "npm run build:food-images",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "acropin-food-images": "^0.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sharp": "^0.32.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs": false,
    "@google/genai": false
  }
}
