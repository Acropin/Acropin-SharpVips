# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Vercel Blob: Create and connect a private Blob store to the Vercel project.
# Vercel adds this token automatically when the store is connected.
BLOB_READ_WRITE_TOKEN=""

# Required in Vercel Production and Preview to authorize catalog/menu changes.
# Store this as a secret environment variable; never commit it to Git.
ADMIN_API_TOKEN=""

# Cloudflare R2 / S3-compatible Object Storage (Optional):
# When unset, Acropin automatically uses the local disk storage provider with full versioned CDN caching.
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="acropin-food-assets"
R2_PUBLIC_DOMAIN="cdn.acropin.com"

# Public contact link shown to developers requesting free API access.
# Vite exposes VITE_* values to browsers; this is intentionally a public mailto link.
VITE_API_ACCESS_CONTACT_URL="mailto:manish.rathaur.dev@gmail.com?subject=Acropin%20Food%20Images%20API%20access"
