# Optional. When unset, uploads receive structural checks only; human review is still required.
GEMINI_API_KEY=

# Legacy Vercel Blob source: needed only while importing old records and image files.
# Keep the existing store connected until the migration is verified. Do not use
# this as the normal runtime store after migration. OIDC or a static token works.
BLOB_READ_WRITE_TOKEN=""

# App records, food image metadata, dish locks, contributor rate limits, and upload intents use Firestore.
# Paste the downloaded service-account JSON as one line; keep the private key escaped as \n.
FIREBASE_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Food image originals and optimized delivery use ImageKit.
# IMAGEKIT_PRIVATE_KEY is server-only; never add it to a VITE_* variable.
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Required in Vercel Production and Preview to authorize catalog/menu changes.
# Store this as a secret environment variable; never commit it to Git.
ADMIN_API_TOKEN=""

# Keep the familiar no-account contributor workflow available. Public uploads
# are always pending owner review; owner edits and approvals still require the
# admin token. Set to false only if you want to disable anonymous submissions.
LEGACY_PUBLIC_CONTRIBUTIONS="true"

# Public contact link shown to developers requesting free API access.
# Vite exposes VITE_* values to browsers; this is intentionally a public mailto link.
VITE_API_ACCESS_CONTACT_URL="mailto:manish.rathaur.dev@gmail.com?subject=Acropin%20Food%20Images%20API%20access"

# GitHub OAuth App for contributor sign-in. Register both callback URLs on the
# same OAuth App (GitHub allows multiple redirect URIs):
# Production: https://acropin-sharpvips.vercel.app/api/auth/github/callback
# Local:      http://localhost:3000/api/auth/github/callback
# Set GITHUB_OAUTH_CALLBACK_URL to the matching URL in each environment.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
# Defaults to the project owner's stable GitHub account ID. Override if ownership changes.
GITHUB_OWNER_ID=116822525

# Approved non-owner accounts can submit up to this many unique dish images per UTC day.
# Valid values: 201-500. The default is 250. The administrator access token bypasses this cap.
GITHUB_CONTRIBUTOR_DAILY_LIMIT=250

# Generate a different random secret for each environment (at least 32 characters).
# Example: openssl rand -base64 48
GITHUB_SESSION_SECRET=
