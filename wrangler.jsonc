{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acropin-food-api",
  "main": "cloudflare/worker.ts",
  "account_id": "277e9a5ff18c63bed6e324cf7aa313e5",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "images": {
    "binding": "IMAGES"
  },
  "cache": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "acropin-food-catalog",
      "database_id": "da1b2672-9f35-4b29-be84-f2d1df9e5fa3",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FOOD_ASSETS",
      "bucket_name": "acropin-food-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_RATE_LIMITER",
        "class_name": "ApiKeyRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ApiKeyRateLimiter"]
    }
  ],
  "vars": {
    "ACCESS_CONTACT_URL": "mailto:manish.rathaur.dev@gmail.com?subject=Acropin%20Food%20Images%20API%20access"
  }
}
