{
  "name": "acropin-food-images",
  "version": "0.1.0",
  "description": "Open food image catalog for menus and food applications",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Acropin/Acropin-SharpVips.git",
    "directory": "packages/food-images"
  },
  "homepage": "https://github.com/Acropin/Acropin-SharpVips/tree/main/packages/food-images",
  "keywords": ["food", "images", "menu", "webp", "restaurant"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./catalog.json": "./dist/catalog.json",
    "./assets/*": "./dist/assets/*"
  },
  "files": ["dist/**", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "prepack": "npm --prefix ../.. run build:food-images"
  },
  "publishConfig": {
    "access": "public"
  }
}
